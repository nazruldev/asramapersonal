{
  "name": "asrama-manager",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cd web && tsx server.ts",
    "build": "cd web && vite build",
    "data:init": "cd web && tsx scripts/generate-initial-db.ts",
    "data:wilayah": "cd web && tsx scripts/export-wilayah-index.ts",
    "prebuild": "npm run data:init && npm run data:wilayah",
    "build:prod": "npm run build",
    "start:prod": "cd web && tsx server.ts --prod",
    "preview": "cd web && vite preview",
    "clean": "node -e \"import('node:fs').then(fs=>fs.promises.rm('web/dist',{recursive:true,force:true}))\"",
    "lint": "cd web && tsc --noEmit",
    "start": "cd web && tsx server.ts --prod",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "electron:release": "npm run build && electron-builder --win --publish always",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "build:android": "npm run build && npm run cap:sync:android",
    "build:apk": "npm run build:android && cd android && gradlew.bat assembleDebug",
    "build:apk:release": "npm run build:android && cd android && gradlew.bat assembleRelease",
    "icons:generate": "node web/scripts/generate-app-icons.mjs"
  },
  "build": {
    "appId": "com.asramapersonal.app",
    "productName": "AsramaPersonal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "web/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AsramaPersonal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "nazruldev",
      "repo": "asramapersonal"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@vitejs/plugin-react": "^6.1.1",
    "capacitor-blob-writer": "^1.1.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "geist": "^1.7.2",
    "jeep-sqlite": "^2.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
